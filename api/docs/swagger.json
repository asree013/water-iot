    "definitions": {
        "entities.TDMAZone": {
            "type": "object",
            "properties": {
                "billed_consumption": {
                    "description": "ปริมาณน้ำที่ขายได้ (ลบ.ม./วัน)",
                    "type": "number"
                },
                "branch_name": {
                    "description": "สาขา (ตาม TOR: นำร่อง 4 สาขา)",
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "customer_count": {
                    "description": "จำนวนผู้ใช้น้ำในโซน",
                    "type": "integer"
                },
                "dma_code": {
                    "description": "รหัส DMA เช่น DMA-01",
                    "type": "string"
                },
                "dma_name": {
                    "description": "ชื่อโซน เช่น โซนเทศบาล 1",
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "nrw_ratio": {
                    "description": "อัตราน้ำสูญเสีย % (Non-Revenue Water)",
                    "type": "number"
                },
                "region_code": {
                    "description": "เขต (ตาม TOR: 10 เขต)",
                    "type": "string"
                },
                "status": {
                    "description": "NORMAL, WARNING, CRITICAL (ตามเกณฑ์แจ้งเตือน)",
                    "type": "string"
                },
                "target_pressure": {
                    "description": "แรงดันเป้าหมาย (bar) เช่น 2.5 (แนะนำ float64 เพื่อใช้เทียบกับ IoT)",
                    "type": "number"
                },
                "total_inflow": {
                    "description": "ปริมาณน้ำจ่ายเข้าโซน (ลบ.ม./วัน)",
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "entities.WaterDataReq": {
            "type": "object",
            "properties": {
                "block": {
                    "type": "string"
                },
                "flow_rate": {
                    "type": "number"
                },
                "latitude": {
                    "type": "number"
                },
                "leakage_flag": {
                    "type": "integer"
                },
                "location_code": {
                    "type": "string"
                },
                "longitude": {
                    "type": "number"
                },
                "operational_hours": {
                    "type": "integer"
                },
                "pipe": {
                    "type": "string"
                },
                "pressure": {
                    "type": "number"
                },
                "rpm": {
                    "type": "number"
                },
                "temperature": {
                    "type": "number"
                },
                "timestamp": {
                    "type": "integer"
                },
                "vibration": {
                    "type": "number"
                },
                "zone": {
                    "type": "string"
                }
            }
